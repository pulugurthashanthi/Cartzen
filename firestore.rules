rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "shanthi87p@gmail.com";
    }

    // Products: anyone can read, only admin can write — except a seller may
    // take their own product off-shelf (flip inStock to false, nothing else)
    // when they delist the listing that published it.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.sellerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["inStock"]) &&
          request.resource.data.inStock == false);
    }

    // Users: each user owns their document and their data subcollection
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users may update their own doc but not change their role —
      // except the one allowed self-upgrade: user -> seller.
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId &&
          (request.resource.data.role == resource.data.role ||
           (resource.data.role == "user" && request.resource.data.role == "seller")));

      // CartZen data subcollection — only the owner can read/write
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Seller listings: sellers submit and manage their own; admin reviews.
    // Approved listings are publicly readable.
    match /sellerProducts/{listingId} {
      allow read: if resource.data.status == "approved" ||
        isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == "pending_review";
      // Sellers can edit until approval; edits go back to review and cannot
      // touch ownership or fee bookkeeping. Once approved, the only self-serve
      // change left is delisting (soft-remove from sale — keeps the fee/review
      // record intact for admin's payment tracking). Admin can update anything.
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.sellerId &&
          resource.data.status != "approved" &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.status == "pending_review" &&
          request.resource.data.feeStatus == resource.data.feeStatus) ||
        (request.auth != null && request.auth.uid == resource.data.sellerId &&
          resource.data.status == "approved" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["delisted", "delistedAt"]) &&
          request.resource.data.delisted == true);
      // Hard delete stays available for pending/rejected listings only —
      // an approved one must go through delist so its fee record survives.
      allow delete: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.sellerId &&
          resource.data.status != "approved");
    }

    // Behavior-change analytics — append-only event log.
    // Anyone (incl. signed-out visitors, who generate most of the funnel) may
    // create an event; only admin can read them back for the Metrics tab.
    // Events can't be edited or deleted. Require a string `name` so the
    // collection can't be used as arbitrary public storage.
    // NOTE seed-stage tradeoff: public create is spammable. A later step
    // would route writes through a server endpoint with the admin SDK.
    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() < 40;
      allow update, delete: if false;
    }
  }
}
